{
  "cli": {
    "appVersionSource": "local",
    "version": "24.12.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":pill-reminders:testDebugUnitTest :app:assembleDebug"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_REMINDER_TESTS": "true"
      }
    },
    "personal": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":pill-reminders:testReleaseUnitTest :app:assembleRelease"
      },
      "env": {
        "APP_VARIANT": "personal",
        "EXPO_PUBLIC_REMINDER_TESTS": "false"
      }
    },
    "reminder-test": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":pill-reminders:testReleaseUnitTest :app:assembleRelease"
      },
      "env": {
        "APP_VARIANT": "reminder-test",
        "EXPO_PUBLIC_REMINDER_TESTS": "true"
      }
    }
  }
}
