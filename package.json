{
  "name": "pill-tracker",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "lint": "eslint . --max-warnings=0"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
